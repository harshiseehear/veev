# Kiosk server configuration

# Port the Express server listens on (Cloud Run sets this automatically).
PORT=8787

# Admin credentials (JSON map of username -> password). If unset, defaults to
# hvrc/fullmetalbitch and michelle/mawg.
# ADMIN_USERS={"hvrc":"fullmetalbitch","michelle":"mawg"}

# Anthropic API key for the in-admin AI assistant. Leave blank to disable the
# assistant (the rest of the app works fine without it). In production this is
# injected from Google Secret Manager, never committed.
ANTHROPIC_API_KEY=

# Model the AI assistant uses (defaults to claude-sonnet-4-6).
KIOSK_AI_MODEL=claude-sonnet-4-6
